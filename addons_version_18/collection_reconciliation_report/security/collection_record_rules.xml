<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="collection_reconciliation_report_company_rule" model="ir.rule">
        <field name="name">Collection Report Multi Company</field>
        <field name="model_id" ref="model_collection_reconciliation_report"/>
        <field name="groups" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="collection_reconciliation_report_kpi_company_rule" model="ir.rule">
        <field name="name">Collection KPI Multi Company</field>
        <field name="model_id" ref="model_collection_reconciliation_report_kpi"/>
        <field name="groups" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_manager'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="collection_reconciliation_refresh_history_company_rule" model="ir.rule">
        <field name="name">Collection Refresh History Multi Company</field>
        <field name="model_id" ref="model_collection_reconciliation_refresh_history"/>
        <field name="groups" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_manager'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
