<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_collection_analytics" model="ir.module.category">
        <field name="name">Collection Analytics</field>
        <field name="description">Access rights for collection reconciliation analytics.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_collection_analytics_user" model="res.groups">
        <field name="name">Collection Analytics User</field>
        <field name="category_id" ref="module_category_collection_analytics"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_collection_analytics_manager" model="res.groups">
        <field name="name">Collection Analytics Manager</field>
        <field name="category_id" ref="module_category_collection_analytics"/>
        <field name="implied_ids" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_user')), (4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
