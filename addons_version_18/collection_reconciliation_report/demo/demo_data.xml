<?xml version="1.0" encoding="UTF-8"?>
<!--
    Demo data for Collection Reconciliation Report
    ================================================
    Odoo loads this file only when the database is created with demo data
    enabled (Settings → Technical → Activate developer mode → Load demo data,
    or the --load-demo-data flag during db creation).

    The <function> tag calls load_demo_data() which creates:
      • 6 demo customers
      • 5 demo products (consulting, support, license, training, integration)
      • Invoices across the last 12 months
      • Payments covering 6 scenarios:
          1. Fully paid on time
          2. Fully paid late  (payment_delay_days > 0)
          3. Partially paid   (payment_state = 'partial')
          4. Overdue unpaid   (appears in overdue_exposure KPI)
          5. Multi-payment    (one invoice, two payments)
          6. Credit note      (out_refund reconciled against invoice)

    All data is tagged with partner refs starting with "DEMO-CRR-" so it can
    be identified and removed cleanly if needed.
-->
<odoo>
    <data noupdate="1">
        <function
            model="collection.reconciliation.report"
            name="_load_demo_data_hook"
        />
    </data>
</odoo>
