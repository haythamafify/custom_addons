<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_collection_analytics" model="ir.ui.view">
        <field name="name">res.partner.form.collection.analytics</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_related_collections"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-users"
                    groups="collection_reconciliation_report.group_collection_analytics_user">
                    <field name="related_collections_count" widget="statinfo" string="Related Collections"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
