<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_collection_analytics" model="ir.ui.view">
        <field name="name">account.move.form.collection.analytics</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_collection_analytics"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-line-chart"
                    groups="collection_reconciliation_report.group_collection_analytics_user">
                    <field name="collection_analytics_count" widget="statinfo" string="Collection Analytics"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
