<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_collection_reconciliation_report_search" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.search</field>
        <field name="model">collection.reconciliation.report</field>
        <field name="arch" type="xml">
            <search string="Collection Reconciliation Report">
                <field name="payment_name"/>
                <field name="invoice_name"/>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="journal_id"/>
                <field name="product_names"/>
                <filter name="filter_paid" string="Paid" domain="[('payment_state', '=', 'paid')]"/>
                <filter name="filter_partial" string="Partial" domain="[('payment_state', '=', 'partial')]"/>
                <filter name="filter_open" string="Open Residual" domain="[('residual_amount', '&gt;', 0)]"/>
                <filter name="filter_overdue" string="Late Customers" domain="[('residual_amount', '&gt;', 0), ('due_date', '&lt;', context_today())]"/>
                <filter name="filter_this_month" string="This Month" domain="[('payment_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="filter_last_30_days" string="Last 30 Days" domain="[('payment_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_payment_date" string="Payment Date" date="payment_date"/>
                <separator/>
                <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'payment_date:month'}"/>
                <searchpanel>
                    <field name="company_id" icon="fa-building"/>
                    <field name="journal_id" icon="fa-book"/>
                    <field name="salesperson_id" icon="fa-user"/>
                    <field name="partner_id" icon="fa-users"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_tree" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.tree</field>
        <field name="model">collection.reconciliation.report</field>
        <field name="arch" type="xml">
            <list string="Collection Reconciliation Report" create="false" delete="false" edit="false" default_order="payment_date desc, id desc" decoration-success="payment_state == 'paid'" decoration-warning="payment_state == 'partial'" decoration-danger="residual_amount &gt; 0">
                <header>
                    <button
                        name="action_refresh_materialized_view"
                        type="object"
                        string="Refresh Materialized View"
                        class="btn-secondary"
                        groups="collection_reconciliation_report.group_collection_analytics_manager"/>

                </header>
                <field name="payment_date"/>
                <field name="payment_id" optional="show"/>
                <field name="payment_name"/>
                <field name="invoice_id" optional="show"/>
                <field name="invoice_name"/>
                <field name="partner_id"/>
                <field name="salesperson_id" optional="show"/>
                <field name="journal_id" optional="show"/>
                <field name="collected_amount" sum="Collected"/>
                <field name="invoice_total" sum="Invoice Total" optional="show"/>
                <field name="residual_amount" sum="Residual"/>
                <field name="invoice_date" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="payment_delay_days" optional="show"/>
                <field name="allocation_count" optional="hide"/>
                <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'" decoration-warning="payment_state == 'partial'"/>
                <field name="invoice_state" widget="badge" optional="hide"/>
                <field name="product_names" optional="hide"/>
                <field name="memo" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_form" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.form</field>
        <field name="model">collection.reconciliation.report</field>
        <field name="arch" type="xml">
            <form string="Collection Reconciliation Report" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_invoice" type="object" string="Open Invoice" class="btn-primary"/>
                    <button name="action_open_payment" type="object" string="Open Payment"/>
                    <button name="action_refresh_materialized_view" type="object" string="Refresh Materialized View" groups="collection_reconciliation_report.group_collection_analytics_manager"/>
                    <button name="action_open_refresh_history" type="object" string="Refresh History" groups="collection_reconciliation_report.group_collection_analytics_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_state != 'paid'"/>
                    <widget name="web_ribbon" title="Partial" bg_color="text-bg-warning" invisible="payment_state != 'partial'"/>
                    <group>
                        <group>
                            <field name="payment_date"/>
                            <field name="payment_id"/>
                            <field name="payment_name"/>
                            <field name="journal_id"/>
                            <field name="memo"/>
                        </group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="invoice_name"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="invoice_state"/>
                            <field name="payment_state"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="salesperson_id"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="collected_amount"/>
                            <field name="invoice_total"/>
                            <field name="residual_amount"/>
                            <field name="payment_delay_days"/>
                            <field name="allocation_count"/>
                        </group>
                    </group>
                    <group string="Reconciliation Details">
                        <group>
                            <field name="reconciled_line_id"/>
                            <field name="payment_move_line_id"/>
                            <field name="invoice_move_line_id"/>
                        </group>
                    </group>
                    <group string="Invoice Products">
                        <field name="product_names"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_pivot" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.pivot</field>
        <field name="model">collection.reconciliation.report</field>
        <field name="arch" type="xml">
            <pivot string="Collection Reconciliation Analysis" disable_linking="false">
                <field name="salesperson_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="journal_id" type="col"/>
                <field name="payment_date" interval="month" type="col"/>
                <field name="collected_amount" type="measure"/>
                <field name="invoice_total" type="measure"/>
                <field name="residual_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_graph" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.graph</field>
        <field name="model">collection.reconciliation.report</field>
        <field name="arch" type="xml">
            <graph string="Collection Reconciliation Graph" type="bar">
                <field name="payment_date" interval="month"/>
                <field name="salesperson_id"/>
                <field name="collected_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_graph_pie" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.graph.pie</field>
        <field name="model">collection.reconciliation.report</field>
        <field name="arch" type="xml">
            <graph string="Collections by Customer" type="pie">
                <field name="partner_id"/>
                <field name="collected_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_kpi_kanban" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.kpi.kanban</field>
        <field name="model">collection.reconciliation.report.kpi</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_card_header">
                                <strong><field name="company_id"/></strong>
                                <span class="badge text-bg-info"><field name="currency_id"/></span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><strong>Total Collected:</strong> <field name="total_collected"/></div>
                                <div><strong>Efficiency:</strong> <field name="collection_efficiency"/>%</div>
                                <div><strong>Recovery:</strong> <field name="recovery_ratio"/>%</div>
                                <div><strong>Overdue Exposure:</strong> <field name="overdue_exposure"/></div>
                                <div><strong>Avg Delay:</strong> <field name="average_payment_delay"/></div>
                                <div><strong>Top Collector:</strong> <field name="best_salesperson_id"/></div>
                                <div><strong>Refresh:</strong> <field name="refresh_status"/></div>
                                <div><strong>Last Refresh:</strong> <field name="last_refresh_at"/></div>
                                <div><strong>Top 3:</strong> <field name="top_collectors"/></div>
                            </div>
                            <footer>
                                <button name="action_open_lines" type="object" string="Open Lines" class="btn btn-primary btn-sm"/>
                                <button name="action_refresh_dashboard" type="object" string="Refresh" class="btn btn-secondary btn-sm" groups="collection_reconciliation_report.group_collection_analytics_manager"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_kpi_tree" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.kpi.tree</field>
        <field name="model">collection.reconciliation.report.kpi</field>
        <field name="arch" type="xml">
            <list string="Collection Reconciliation Dashboard" create="false" delete="false" edit="false" decoration-success="collection_efficiency &gt;= 80" decoration-warning="collection_efficiency &lt; 80 and collection_efficiency &gt;= 50" decoration-danger="collection_efficiency &lt; 50">
                <header>
                    <button
                        name="action_refresh_dashboard"
                        type="object"
                        string="Refresh Dashboard"
                        class="btn-primary"
                        groups="collection_reconciliation_report.group_collection_analytics_manager"/>

                </header>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="total_collected" sum="Collected"/>
                <field name="total_invoice_amount" sum="Invoice Total"/>
                <field name="total_residual" sum="Residual"/>
                <field name="line_count" sum="Rows"/>
                <field name="invoice_count" sum="Invoices"/>
                <field name="payment_count" sum="Payments"/>
                <field name="customer_count" sum="Customers"/>
                <field name="partial_line_count" sum="Partial Rows"/>
                <field name="monthly_collection_growth"/>
                <field name="collection_efficiency"/>
                <field name="recovery_ratio"/>
                <field name="average_payment_delay"/>
                <field name="overdue_exposure"/>
                <field name="unpaid_invoice_ratio"/>
                <field name="best_salesperson_id"/>
                <field name="refresh_status" widget="badge"/>
                <field name="last_refresh_at"/>
                <field name="refresh_duration_seconds"/>
                <button name="action_open_lines" type="object" string="Open Lines"/>
            </list>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_kpi_pivot" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.kpi.pivot</field>
        <field name="model">collection.reconciliation.report.kpi</field>
        <field name="arch" type="xml">
            <pivot string="Collection Dashboard">
                <field name="company_id" type="row"/>
                <field name="currency_id" type="col"/>
                <field name="total_collected" type="measure"/>
                <field name="total_invoice_amount" type="measure"/>
                <field name="total_residual" type="measure"/>
                <field name="invoice_count" type="measure"/>
                <field name="payment_count" type="measure"/>
                <field name="partial_line_count" type="measure"/>
                <field name="collection_efficiency" type="measure"/>
                <field name="recovery_ratio" type="measure"/>
                <field name="overdue_exposure" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_kpi_graph" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.kpi.graph</field>
        <field name="model">collection.reconciliation.report.kpi</field>
        <field name="arch" type="xml">
            <graph string="Collection Dashboard" type="bar">
                <field name="company_id"/>
                <field name="total_collected" type="measure"/>
                <field name="total_residual" type="measure"/>
                <field name="overdue_exposure" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_collection_reconciliation_report_kpi_form" model="ir.ui.view">
        <field name="name">collection.reconciliation.report.kpi.form</field>
        <field name="model">collection.reconciliation.report.kpi</field>
        <field name="arch" type="xml">
            <form string="Collection Dashboard" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_lines" type="object" string="Open Lines" class="btn-primary"/>
                    <button name="action_refresh_dashboard" type="object" string="Refresh Dashboard" groups="collection_reconciliation_report.group_collection_analytics_manager"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="best_salesperson_id"/>
                            <field name="top_collectors"/>
                            <field name="refresh_status"/>
                            <field name="last_refresh_at"/>
                        </group>
                        <group>
                            <field name="total_collected"/>
                            <field name="total_invoice_amount"/>
                            <field name="total_residual"/>
                            <field name="overdue_exposure"/>
                        </group>
                    </group>
                    <group string="Performance Metrics">
                        <group>
                            <field name="monthly_collection_growth"/>
                            <field name="collection_efficiency"/>
                            <field name="recovery_ratio"/>
                        </group>
                        <group>
                            <field name="average_payment_delay"/>
                            <field name="unpaid_invoice_ratio"/>
                            <field name="best_salesperson_amount"/>
                            <field name="refresh_duration_seconds"/>
                            <field name="is_stale"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_collection_reconciliation_refresh_history_tree" model="ir.ui.view">
        <field name="name">collection.reconciliation.refresh.history.tree</field>
        <field name="model">collection.reconciliation.refresh.history</field>
        <field name="arch" type="xml">
            <list string="Refresh History" create="false" edit="false" delete="false" decoration-success="status == 'success'" decoration-warning="status == 'skipped'" decoration-danger="status == 'failed'">
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="company_id"/>
                <field name="relation_name"/>
                <field name="refresh_mode"/>
                <field name="status" widget="badge"/>
                <field name="duration_seconds"/>
                <field name="last_refresh_at"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_collection_reconciliation_refresh_history_form" model="ir.ui.view">
        <field name="name">collection.reconciliation.refresh.history.form</field>
        <field name="model">collection.reconciliation.refresh.history</field>
        <field name="arch" type="xml">
            <form string="Refresh History" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="relation_name"/>
                            <field name="refresh_mode"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="last_refresh_at"/>
                            <field name="duration_seconds"/>
                        </group>
                    </group>
                    <group string="Diagnostics">
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_collection_reconciliation_refresh_history" model="ir.actions.act_window">
        <field name="name">Refresh History</field>
        <field name="res_model">collection.reconciliation.refresh.history</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_manager'))]"/>
    </record>

    <record id="action_collection_reconciliation_report" model="ir.actions.act_window">
        <field name="name">Collection Reconciliation</field>
        <field name="res_model">collection.reconciliation.report</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_collection_reconciliation_report_search"/>
        <field name="context">{'search_default_group_month': 1}</field>
        <field name="groups_id" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_user'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Payment-to-invoice reconciliation analytics powered by SQL.
            </p>
            <p>
                Review exact collected amounts per invoice even when one payment
                spans multiple invoices or multiple payments settle the same invoice.
            </p>
        </field>
    </record>

    <record id="action_collection_reconciliation_report_dashboard" model="ir.actions.act_window">
        <field name="name">Collection Dashboard</field>
        <field name="res_model">collection.reconciliation.report.kpi</field>
        <field name="view_mode">kanban,list,pivot,graph,form</field>
        <field name="groups_id" eval="[(4, ref('collection_reconciliation_report.group_collection_analytics_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                SQL-powered KPI dashboard for collections and outstanding balances.
            </p>
        </field>
    </record>


</odoo>
